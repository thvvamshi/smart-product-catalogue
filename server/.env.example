NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://catalogue:catalogue_local_only@localhost:5432/catalogue_dev
CLIENT_URL=http://localhost:5173,http://localhost:5174
RESERVATION_TTL_MINUTES=10
RESERVATION_EXPIRY_INTERVAL_MS=30000
ETA_AVERAGE_SPEED_KMH=20
ETA_DISPATCH_BUFFER_MINUTES=5
ETA_UNCERTAINTY_BUFFER_MINUTES=5
ETA_VALIDITY_MINUTES=10
DELIVERY_LOCATION_MAX_CLOCK_SKEW_SECONDS=120
DELIVERY_LOCATION_MIN_INTERVAL_SECONDS=5
DELIVERY_LOCATION_MAX_AGE_SECONDS=120
DEMO_AUTO_ACCEPT_STORE_ORDERS=false
DEMO_DELIVERY_SIMULATION_ENABLED=false
DEMO_DELIVERY_SPEED_KMH=20
DEMO_DELIVERY_TICK_INTERVAL_MS=5000
DEMO_DELIVERY_PREPARATION_DURATION_SECONDS=30
# Required only when running integration tests:
TEST_DATABASE_URL=postgresql://catalogue_test:catalogue_test_local_only@localhost:5433/catalogue_test
